#!/usr/bin/env bash
# wallpaper-monitor -- gerencia overrides de wallpaper por monitor (e por
# orientacao) para o plugin vitorcanoas.background
# (~/.config/omarchy/plugins/vitorcanoas.background).
#
# O override fica em ~/.config/omarchy/background-per-monitor.json, formato
# novo (migrado automaticamente a partir do formato antigo plano):
#   {
#     "monitors": { "DP-2": "/caminho/a.png", "HDMI-A-1": "/caminho/b.png" },
#     "portrait": "/caminho/vertical-padrao.png",
#     "landscape": "/caminho/horizontal-padrao.png"
#   }
#
# Formato antigo (ainda lido pelo plugin, mas este CLI migra para o novo
# assim que grava algo): { "DP-2": "/a.png", "HDMI-A-1": "/b.png" }
#
# Precedencia no plugin: monitors[nome] > portrait/landscape (conforme
# height > width pos-rotacao) > symlink nativo do Omarchy.
#
# O plugin QML observa esse arquivo ao vivo (FileView watchChanges: true) --
# nao e preciso reiniciar o shell depois de set/clear.
#
# Ideia de fallback por orientacao portada do PR upstream #10249 (DCPRevere,
# omacom/omarchy, https://github.com/omacom/omarchy/pull/10249).

set -euo pipefail

OVERRIDE_JSON="${HOME}/.config/omarchy/background-per-monitor.json"

# Codigos de saida:
#   1 = erro de uso / argumento invalido
#   2 = JSON existe mas esta ilegivel (NADA foi alterado)
#   3 = nao foi possivel serializar a escrita (lock)
EXIT_UNREADABLE=2
EXIT_LOCK=3

usage() {
  cat >&2 <<EOF
Uso:
  wallpaper-monitor set <MONITOR> <caminho-imagem>   grava override para o monitor
  wallpaper-monitor set-portrait <caminho-imagem>    grava o default de retrato (portrait)
  wallpaper-monitor set-landscape <caminho-imagem>   grava o default de paisagem (landscape)
  wallpaper-monitor list                             mostra overrides + defaults + monitores detectados
  wallpaper-monitor clear <MONITOR>                  remove override do monitor
  wallpaper-monitor clear-portrait                   remove o default de retrato
  wallpaper-monitor clear-landscape                  remove o default de paisagem

Exemplos:
  wallpaper-monitor set DP-2 ~/Pictures/wallpapers-rick-and-morty/render/16x9/unico-b-rick-morty-battle-dark-8000.png
  wallpaper-monitor set-portrait ~/Pictures/wallpapers-rick-and-morty/render/9x16/retrato-rick-amoled-02.png
  wallpaper-monitor clear HDMI-A-1
  wallpaper-monitor list

Formato antigo (plano, sem a chave "monitors") e migrado automaticamente para
o formato novo na primeira escrita deste CLI; um backup .bak e feito antes.
EOF
  exit 1
}

# ---------------------------------------------------------------------------
# Serializacao das escritas.
#
# A substituicao final (mv) ja era atomica, mas o ciclo le-modifica-grava nao
# era serializado: `wp h 3 & wp v 5 &` fazia os dois lerem o mesmo JSON antigo
# e o perdedor sumia do arquivo. O lock abaixo cobre migrate+leitura+escrita
# inteira, de ponta a ponta.
#
# Lock por DIRETORIO (mkdir), nao por `flock 9>arquivo`: mkdir nao segue
# symlink no componente final, entao o caminho do lock nunca e aberto atraves
# de um link plantado por outro processo. Mesma tecnica ja aprovada no PR #8 de
# vitorcanoas/omarchy-nightlight (commit 78d9fb4), exigida pelo mantenedor do
# marketplace Omarchy.
RUNTIME_DIR=""
LOCK=""

runtime_dir_is_private() {
  local dir=${1-} mode
  [[ -n $dir && -d $dir && ! -L $dir && -O $dir ]] || return 1
  mode=$(stat -c '%a' -- "$dir" 2>/dev/null) || return 1
  [[ $mode == 700 ]]
}

# XDG_RUNTIME_DIR e um diretorio privado por definicao. Quando falta, cai para
# um diretorio por usuario em /tmp, criado com modo 0700 e recusado se outro
# usuario ja controla o nome. Nunca cai para um lock global.
prepare_runtime_dir() {
  local candidate tmp_mode
  if [[ -n ${XDG_RUNTIME_DIR:-} ]] && runtime_dir_is_private "${XDG_RUNTIME_DIR:-}"; then
    RUNTIME_DIR=$XDG_RUNTIME_DIR
  else
    candidate="/tmp/omarchy-wallpaper-monitor-${EUID}"
    [[ -d /tmp && ! -L /tmp && -w /tmp && -k /tmp ]] || return 1
    tmp_mode=$(stat -c '%a' -- /tmp 2>/dev/null) || return 1
    (( 8#$tmp_mode & 01000 )) || return 1
    [[ ! -L $candidate ]] || return 1
    if [[ ! -e $candidate ]]; then
      ( umask 077; mkdir -- "$candidate" ) 2>/dev/null || return 1
    fi
    runtime_dir_is_private "$candidate" || return 1
    RUNTIME_DIR=$candidate
  fi
  LOCK="$RUNTIME_DIR/omarchy-wallpaper-monitor.lock.d"
}

acquire_lock() {
  local path=$1 deadline=$((SECONDS + 5)) owner created now
  while :; do
    [[ ! -L $path && ( ! -e $path || -d $path ) ]] || return 1
    if ( umask 077; mkdir -- "$path" ) 2>/dev/null; then
      if printf '%s\n' "$$" >"$path/pid" 2>/dev/null; then
        return 0
      fi
      rm -f -- "$path/pid" 2>/dev/null || true
      rmdir -- "$path" 2>/dev/null || true
      return 1
    fi

    [[ ! -L $path && -d $path ]] || return 1
    owner=$(cat -- "$path/pid" 2>/dev/null || true)
    if [[ $owner =~ ^[0-9]+$ ]] && ! kill -0 "$owner" 2>/dev/null; then
      rm -f -- "$path/pid" 2>/dev/null || true
      rmdir -- "$path" 2>/dev/null || true
      continue
    fi
    if [[ ! $owner =~ ^[0-9]+$ ]]; then
      # SIGKILL entre o mkdir e a gravacao do pid deixa um lock valido sem dono.
      # Nao remove um lock que pode ter nascido agora; passado o timeout normal
      # de aquisicao e seguro recuperar esse lock incompleto.
      created=$(stat -c '%Y' -- "$path" 2>/dev/null || echo 0)
      now=$(date +%s 2>/dev/null || echo 0)
      if [[ $created =~ ^[0-9]+$ && $now =~ ^[0-9]+$ ]] && (( now - created >= 5 )); then
        rmdir -- "$path" 2>/dev/null || true
        continue
      fi
    fi
    (( SECONDS >= deadline )) && return 1
    LC_ALL=C sleep 0.05 || return 1
  done
}

release_lock() {
  local path=${1-}
  [[ -n $path && ! -L $path && -d $path ]] || return 0
  rm -f -- "$path/pid" 2>/dev/null || true
  rmdir -- "$path" 2>/dev/null || true
}

# Executa "$@" com o lock de escrita segurado. Sai com erro claro se nao
# conseguir serializar -- melhor recusar do que gravar por cima de outro.
with_lock() {
  if ! prepare_runtime_dir; then
    echo "erro: nao foi possivel preparar um diretorio de runtime privado para o lock; nada foi alterado" >&2
    exit "$EXIT_LOCK"
  fi
  if ! acquire_lock "$LOCK"; then
    echo "erro: outro wallpaper-monitor esta gravando (lock: $LOCK); nada foi alterado" >&2
    exit "$EXIT_LOCK"
  fi
  trap 'release_lock "$LOCK"' EXIT
  "$@"
}

ensure_json_exists() {
  if [[ ! -f "$OVERRIDE_JSON" ]]; then
    mkdir -p "$(dirname "$OVERRIDE_JSON")"
    ( umask 022; printf '{\n  "monitors": {}\n}\n' > "$OVERRIDE_JSON" )
  fi
}

# Trecho Python compartilhado: le o JSON de destino com as validacoes que o
# mantenedor do marketplace exige (no-follow, arquivo regular, dono, tamanho
# limitado) e distingue "nao existe" (ok, comeca vazio) de "existe mas esta
# ilegivel" (ERRO -- nada pode ser alterado).
#
# Nunca interpolar dado externo aqui dentro: tudo entra por argv.
read_json_py() {
  cat <<'PYEOF'
import json
import os
import stat
import sys

MAX_BYTES = 1 << 20  # 1 MiB: um mapa de overrides nao chega perto disso


def load_target(path):
    """Retorna (data, existia). Levanta SystemExit(2) se existir e for ilegivel."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    except FileNotFoundError:
        return {}, False
    except OSError as e:
        print(
            f"erro: {path} existe mas esta ilegivel ({e}) -- nada foi alterado",
            file=sys.stderr,
        )
        raise SystemExit(2)

    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            print(
                f"erro: {path} existe mas nao e um arquivo regular -- nada foi alterado",
                file=sys.stderr,
            )
            raise SystemExit(2)
        if st.st_uid != os.geteuid():
            print(
                f"erro: {path} pertence a outro usuario (uid {st.st_uid}) -- nada foi alterado",
                file=sys.stderr,
            )
            raise SystemExit(2)
        if st.st_size > MAX_BYTES:
            print(
                f"erro: {path} tem {st.st_size} bytes (limite {MAX_BYTES}) -- nada foi alterado",
                file=sys.stderr,
            )
            raise SystemExit(2)
        raw = os.read(fd, MAX_BYTES)
    finally:
        os.close(fd)

    if not raw.strip():
        # Arquivo vazio: trata como "ainda nao configurado", nao como corrupcao.
        return {}, True

    try:
        data = json.loads(raw.decode("utf-8"))
    except (ValueError, UnicodeDecodeError) as e:
        print(
            f"erro: {path} existe mas esta ilegivel ({e}) -- nada foi alterado.",
            file=sys.stderr,
        )
        print(
            "       conserte o arquivo a mao ou remova-o para recomecar do zero.",
            file=sys.stderr,
        )
        raise SystemExit(2)

    if not isinstance(data, dict):
        print(
            f"erro: {path} existe mas nao contem um objeto JSON -- nada foi alterado.",
            file=sys.stderr,
        )
        print(
            "       conserte o arquivo a mao ou remova-o para recomecar do zero.",
            file=sys.stderr,
        )
        raise SystemExit(2)

    return data, True


def write_atomic(path, data, mode=None):
    """Grava data em path via temp no MESMO diretorio + fsync + rename."""
    import tempfile

    directory = os.path.dirname(path) or "."
    if mode is None:
        try:
            mode = stat.S_IMODE(os.stat(path).st_mode)
        except OSError:
            mode = 0o644

    fd, tmp_path = tempfile.mkstemp(dir=directory, prefix=".background-per-monitor.", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2, ensure_ascii=False)
            f.write("\n")
            f.flush()
            os.fsync(f.fileno())
        # mkstemp cria 0600; preserva o modo do original (ou 644) para o arquivo
        # nao virar ilegivel para o resto da sessao do usuario.
        os.chmod(tmp_path, mode)
        os.replace(tmp_path, path)
        tmp_path = None
    finally:
        if tmp_path is not None:
            try:
                os.unlink(tmp_path)
            except OSError:
                pass

    # Durabilidade do rename: sem isso um corte de energia logo depois pode
    # deixar o diretorio sem a entrada nova.
    try:
        dfd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(dfd)
        finally:
            os.close(dfd)
    except OSError:
        pass


def normalize(data):
    if not isinstance(data.get("monitors"), dict):
        data["monitors"] = {}
    return data
PYEOF
}

# Migra o JSON do formato antigo (plano, sem "monitors") para o novo
# ({"monitors": {...}}), preservando o conteudo. Faz backup antes. E
# idempotente: se ja estiver no formato novo, nao faz nada (nem backup).
#
# So e chamada por comandos de ESCRITA, e sempre com o lock ja segurado.
migrate_if_needed() {
  ensure_json_exists

  local needs_migration
  needs_migration="$(python3 - "$OVERRIDE_JSON" <<PYEOF
$(read_json_py)

json_path = sys.argv[1]
data, _existed = load_target(json_path)

if "monitors" in data and isinstance(data["monitors"], dict):
    print("no")
else:
    print("yes")
PYEOF
)" || exit "$EXIT_UNREADABLE"

  if [[ "$needs_migration" != "yes" ]]; then
    return 0
  fi

  local bak
  bak="${OVERRIDE_JSON}.bak.$(date +%Y%m%d-%H%M%S)"
  cp -p -- "$OVERRIDE_JSON" "$bak"
  echo "aviso: JSON no formato antigo detectado -- migrando para o formato novo (backup: $bak)" >&2

  python3 - "$OVERRIDE_JSON" <<PYEOF || exit "$EXIT_UNREADABLE"
$(read_json_py)

json_path = sys.argv[1]
data, _existed = load_target(json_path)

# Formato antigo: objeto plano monitor -> caminho. Formato novo: tudo isso
# vira o mapa "monitors". A funcao chamadora ja garantiu que "monitors" ainda
# nao existe como dict aqui.
write_atomic(json_path, {"monitors": data})
PYEOF
}

# Resolve um caminho de imagem para absoluto, confere que existe e que e mesmo
# uma imagem -- `set DP-1 /etc/hostname` gravava sem reclamar e o usuario so
# descobria pela tela preta.
# Nomes de monitor vem de conectores do kernel (DP-2, HDMI-A-1, eDP-1), entao a
# forma real e sempre alfanumerica com . _ : -. Recusar o resto nao e defesa
# contra injecao -- os dados sempre cruzam por argv, nunca sao interpolados em
# codigo -- e sim contra a falha SILENCIOSA: gravar override para um nome que
# nenhum monitor pode ter faz o wallpaper simplesmente nao aparecer, sem erro.
valida_nome_monitor() {
  local monitor="$1"
  if [[ ! "$monitor" =~ ^[A-Za-z0-9._:-]+$ ]]; then
    echo "erro: nome de monitor invalido: $monitor" >&2
    echo "       use o nome do conector, como aparece em 'wallpaper-monitor list'" >&2
    echo "       (letras, numeros e . _ : -)" >&2
    exit 1
  fi
}

resolve_image() {
  local image="$1"
  local abs_image
  abs_image="$(realpath -m -- "$image")"
  if [[ ! -f "$abs_image" ]]; then
    echo "erro: arquivo de imagem nao existe: $abs_image" >&2
    exit 1
  fi

  local mime=""
  if command -v file >/dev/null 2>&1; then
    mime="$(file -b --mime-type -- "$abs_image" 2>/dev/null || true)"
  fi

  if [[ -n "$mime" ]]; then
    if [[ "$mime" != image/* ]]; then
      echo "erro: nao parece uma imagem: $abs_image (mime: $mime)" >&2
      exit 1
    fi
  else
    # Sem `file` disponivel, cai para a extensao -- pior que o mime, mas ainda
    # pega o caso comum de apontar para um arquivo de texto por engano.
    local lower="${abs_image,,}"
    case "$lower" in
      *.png|*.jpg|*.jpeg|*.webp|*.avif|*.bmp|*.gif|*.tif|*.tiff) ;;
      *)
        echo "erro: extensao nao reconhecida como imagem: $abs_image" >&2
        exit 1
        ;;
    esac
  fi

  printf '%s' "$abs_image"
}

cmd_set() {
  if [[ $# -ne 2 ]]; then
    echo "erro: uso: wallpaper-monitor set <MONITOR> <caminho-imagem>" >&2
    exit 1
  fi

  local monitor="$1"
  local image="$2"

  if [[ -z "$monitor" || -z "$image" ]]; then
    echo "erro: uso: wallpaper-monitor set <MONITOR> <caminho-imagem>" >&2
    exit 1
  fi

  valida_nome_monitor "$monitor"

  local abs_image
  abs_image="$(resolve_image "$image")"

  with_lock cmd_set_locked "$monitor" "$abs_image"

  echo "ok: $monitor -> $abs_image"
}

cmd_set_locked() {
  local monitor="$1" abs_image="$2"

  migrate_if_needed

  python3 - "$OVERRIDE_JSON" "$monitor" "$abs_image" <<PYEOF || exit "$EXIT_UNREADABLE"
$(read_json_py)

json_path, monitor, image = sys.argv[1:4]

data, _existed = load_target(json_path)
data = normalize(data)
data["monitors"][monitor] = image
write_atomic(json_path, data)
PYEOF
}

cmd_set_orientation() {
  local key="$1"
  shift

  if [[ $# -ne 1 ]]; then
    echo "erro: uso: wallpaper-monitor set-${key} <caminho-imagem>" >&2
    exit 1
  fi

  local image="$1"
  if [[ -z "$image" ]]; then
    echo "erro: uso: wallpaper-monitor set-${key} <caminho-imagem>" >&2
    exit 1
  fi

  local abs_image
  abs_image="$(resolve_image "$image")"

  with_lock cmd_set_orientation_locked "$key" "$abs_image"

  echo "ok: ${key} -> $abs_image"
}

cmd_set_orientation_locked() {
  local key="$1" abs_image="$2"

  migrate_if_needed

  python3 - "$OVERRIDE_JSON" "$key" "$abs_image" <<PYEOF || exit "$EXIT_UNREADABLE"
$(read_json_py)

json_path, key, image = sys.argv[1:4]

data, _existed = load_target(json_path)
data = normalize(data)
data[key] = image
write_atomic(json_path, data)
PYEOF
}

cmd_clear() {
  if [[ $# -ne 1 ]]; then
    echo "erro: uso: wallpaper-monitor clear <MONITOR>" >&2
    exit 1
  fi

  local monitor="$1"
  if [[ -z "$monitor" ]]; then
    echo "erro: uso: wallpaper-monitor clear <MONITOR>" >&2
    exit 1
  fi

  valida_nome_monitor "$monitor"

  with_lock cmd_clear_locked "$monitor"

  echo "ok: override removido para $monitor (volta ao default de orientacao ou ao wallpaper padrao)"
}

cmd_clear_locked() {
  local monitor="$1"

  migrate_if_needed

  python3 - "$OVERRIDE_JSON" "$monitor" <<PYEOF || exit "$EXIT_UNREADABLE"
$(read_json_py)

json_path, monitor = sys.argv[1:3]

data, _existed = load_target(json_path)
data = normalize(data)
data["monitors"].pop(monitor, None)
write_atomic(json_path, data)
PYEOF
}

cmd_clear_orientation() {
  local key="$1"
  shift

  if [[ $# -ne 0 ]]; then
    echo "erro: uso: wallpaper-monitor clear-${key} (sem argumentos)" >&2
    exit 1
  fi

  with_lock cmd_clear_orientation_locked "$key"

  echo "ok: default de ${key} removido"
}

cmd_clear_orientation_locked() {
  local key="$1"

  migrate_if_needed

  python3 - "$OVERRIDE_JSON" "$key" <<PYEOF || exit "$EXIT_UNREADABLE"
$(read_json_py)

json_path, key = sys.argv[1:3]

data, _existed = load_target(json_path)
data.pop(key, None)
write_atomic(json_path, data)
PYEOF
}

# list e READ-ONLY: nunca migra, nunca grava. Um comando de diagnostico que
# reescreve o arquivo que voce esta tentando diagnosticar e o pior tipo de bug
# -- antes desta correcao, um `list` num JSON corrompido apagava todos os
# overrides.
cmd_list() {
  if [[ $# -ne 0 ]]; then
    echo "erro: uso: wallpaper-monitor list (sem argumentos)" >&2
    exit 1
  fi

  echo "== Overrides configurados ($OVERRIDE_JSON) =="
  local rc=0
  python3 - "$OVERRIDE_JSON" <<PYEOF || rc=$?
$(read_json_py)

json_path = sys.argv[1]
data, existed = load_target(json_path)

if not existed:
    print("  (nenhum override configurado ainda -- o arquivo nem existe)")
    raise SystemExit(0)

monitors = data.get("monitors")
monitors = monitors if isinstance(monitors, dict) else {}

# Formato antigo (plano): mostra assim mesmo, sem migrar. list e read-only.
if not monitors and any(
    k not in ("monitors", "portrait", "landscape") for k in data
):
    print("  (formato antigo, plano -- sera migrado na proxima escrita)")
    monitors = {k: v for k, v in data.items() if k not in ("portrait", "landscape")}

if not monitors:
    print("  (nenhum override de monitor definido)")
else:
    for monitor, path in monitors.items():
        if isinstance(path, str):
            print(f"  {monitor} -> {path}")
        else:
            print(f"  {monitor} -> (valor invalido, nao e um caminho: {path!r})")

print()
for key in ("portrait", "landscape"):
    value = data.get(key)
    label = key.ljust(9)
    if value is None:
        print(f"  {label} -> (nao definido)")
    elif isinstance(value, str):
        print(f"  {label} -> {value}")
    else:
        print(f"  {label} -> (valor invalido, nao e um caminho: {value!r})")
PYEOF

  if [[ $rc -ne 0 ]]; then
    exit "$EXIT_UNREADABLE"
  fi

  echo
  echo "== Monitores detectados (hyprctl monitors -j) =="
  if command -v hyprctl >/dev/null 2>&1; then
    local hypr_raw=""
    hypr_raw="$(hyprctl monitors -j 2>/dev/null)" || hypr_raw=""
    # O JSON entra por argv, nao por stdin: `hyprctl | python3 - <<EOF` faz o
    # heredoc virar o stdin do python, entao sys.stdin.read() leria o proprio
    # script e o hyprctl levava SIGPIPE.
    python3 - "$hypr_raw" <<'PYEOF'
import json
import sys

raw = sys.argv[1]
try:
    monitors = json.loads(raw) if raw.strip() else []
except ValueError as e:
    print(f"  (falha ao ler hyprctl monitors -j: {e})", file=sys.stderr)
    monitors = []

if not isinstance(monitors, list):
    monitors = []

for m in monitors:
    if not isinstance(m, dict):
        continue
    name = m.get("name")
    if not name:
        continue
    width = m.get("width")
    height = m.get("height")
    transform = m.get("transform", 0)
    if not isinstance(transform, int):
        transform = 0

    if isinstance(width, int) and isinstance(height, int):
        # hyprctl reporta a dimensao FISICA do modo; transform impar inverte
        # w/h na tela. Imprimir a fisica fazia o usuario ler "1920x1080" para
        # um monitor que o `wp` trata (corretamente) como retrato, e configurar
        # o monitor errado. Ver docs/CONTEXTO.md secao e.
        w, h = (height, width) if transform % 2 else (width, height)
        orient = "portrait" if h > w else "landscape"
        extra = f", fisico {width}x{height}" if (w, h) != (width, height) else ""
        print(f"  {name} ({w}x{h} logico, {orient}, transform={transform}{extra})")
    else:
        print(f"  {name} (dimensoes desconhecidas, transform={transform})")

    if m.get("disabled"):
        print("      (desativado -- nao recebe wallpaper)")
PYEOF
  else
    echo "  (hyprctl nao encontrado)"
  fi
}

main() {
  local action="${1:-}"
  shift || true

  case "$action" in
    set)             cmd_set "$@" ;;
    set-portrait)    cmd_set_orientation portrait "$@" ;;
    set-landscape)   cmd_set_orientation landscape "$@" ;;
    clear)           cmd_clear "$@" ;;
    clear-portrait)  cmd_clear_orientation portrait "$@" ;;
    clear-landscape) cmd_clear_orientation landscape "$@" ;;
    list)            cmd_list "$@" ;;
    *)               usage ;;
  esac
}

main "$@"
