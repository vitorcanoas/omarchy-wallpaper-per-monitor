#!/usr/bin/env bash
# wp - escolhe wallpaper por numero, por monitor.
#   wp                 lista os dois catalogos
#   wp h 12            aplica a 12a arte deitada no monitor horizontal
#   wp v 3             aplica a 3a arte em pe no monitor vertical
#   wp h 12 DP-3       aplica no monitor DP-3 (quando ha mais de um horizontal)
#   wp h               so lista as deitadas
# Descobre o monitor pela orientacao real (hyprctl), nao por nome chumbado.
set -uo pipefail

# LC_ALL=C fixa a ordem do catalogo. Sem isso o glob segue LC_COLLATE, que muda
# entre um terminal interativo e um keybind/systemd -- o mesmo `wp h 5` pegava
# artes diferentes conforme de onde era chamado (art-10 antes ou depois de
# art-2). A numeracao que o usuario memoriza precisa ser estavel.
export LC_ALL=C

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
CLI="$(dirname "$SELF")/wallpaper-monitor"
[[ -x $CLI ]] || CLI="wallpaper-monitor"

# Raiz do catalogo de artes. A resolucao acompanha a do wallpaper-monitor-menu
# -- as duas precisam achar o MESMO catalogo, senao o numero que o menu mostra
# e o que o `wp` aplica divergem.
#
# Ordem: $WALLPAPER_MONITOR_DIR > ~/Pictures/wallpapers/render > a raiz
# deduzida dos overrides ja gravados > o checkout ao lado deste script.
#
# O ultimo item era, ate aqui, o UNICO criterio (BASE=$(dirname $0)/..), e por
# isso `wp h` rodado pelo symlink de ~/.local/bin resolvia para a pasta do
# plugin instalado -- que nao tem render/ nenhum. O comando entao imprimia
# "(sem 16x9)" e saia 0, como se o catalogo estivesse vazio: falha silenciosa,
# indistinguivel de "nao ha artes". So acertava chamado de dentro do checkout.
resolve_raiz_wp() {
  if [[ -n ${WALLPAPER_MONITOR_DIR:-} ]]; then
    # Configurado a mao: se estiver errado, dizer -- cair calado para outro
    # caminho aplicaria arte de um catalogo que o usuario nao pediu.
    if [[ ! -d $WALLPAPER_MONITOR_DIR ]]; then
      echo "erro: WALLPAPER_MONITOR_DIR aponta para diretorio inexistente: $WALLPAPER_MONITOR_DIR" >&2
      return 1
    fi
    printf '%s\n' "$WALLPAPER_MONITOR_DIR"
    return 0
  fi

  [[ -d "$HOME/Pictures/wallpapers/render" ]] && {
    printf '%s\n' "$HOME/Pictures/wallpapers/render"; return 0; }

  # Deduz do override ja gravado: um caminho .../catalogo/render/16x9/arte.png
  # coloca a raiz dois niveis acima do arquivo.
  local j="$HOME/.config/omarchy/background-per-monitor.json" raiz
  if [[ -f $j ]]; then
    raiz="$(python3 - "$j" <<'PYEOF' 2>/dev/null || true
import json, os, sys
try:
    if os.path.getsize(sys.argv[1]) > (1 << 20):
        sys.exit(1)
    with open(sys.argv[1], "rb") as fh:
        d = json.loads(fh.read().decode("utf-8"))
except (OSError, ValueError, UnicodeDecodeError):
    sys.exit(1)
if not isinstance(d, dict):
    sys.exit(1)
p = []
m = d.get("monitors")
if isinstance(m, dict):
    p.extend(v for v in m.values() if isinstance(v, str))
for k in ("portrait", "landscape"):
    v = d.get(k)
    if isinstance(v, str):
        p.append(v)
for c in p:
    r = os.path.dirname(os.path.dirname(c))
    if os.path.isdir(r):
        print(r)
        break
PYEOF
)"
    [[ -n $raiz && -d $raiz ]] && { printf '%s\n' "$raiz"; return 0; }
  fi

  # Ultimo recurso: o checkout ao lado deste script.
  local base
  base="$(cd "$(dirname "$SELF")/.." && pwd)"
  [[ -d "$base/render" ]] && { printf '%s\n' "$base/render"; return 0; }
  return 1
}

if ! R="$(resolve_raiz_wp)"; then
  echo "erro: catalogo de artes nao encontrado." >&2
  echo "      defina WALLPAPER_MONITOR_DIR apontando para a pasta que contem" >&2
  echo "      os subdiretorios 16x9/ e 9x16/, ou crie ~/Pictures/wallpapers/render." >&2
  exit 1
fi

# Nomes de monitor aceitos. O pipeline abaixo (print -> grep -c -> head -n1) e
# delimitado por newline, entao um nome contendo \n seria truncado no meio e o
# override iria para um monitor que nao existe. Validar o formato e mais
# simples que trocar todo o pipeline para NUL, e nomes de conector reais
# (DP-2, HDMI-A-1, eDP-1, desc:...) cabem folgadamente aqui.
MONITOR_RE='^[A-Za-z0-9._:-]+$'

mon_por_orientacao() {  # $1 = portrait|landscape
  command -v hyprctl >/dev/null 2>&1 || { echo "erro: hyprctl nao encontrado (sem Hyprland rodando?)" >&2; return 1; }
  local candidatos
  candidatos="$(hyprctl monitors -j | python3 -c "
import sys, json

alvo = sys.argv[1]
raw = sys.stdin.read()
if not raw.strip():
    sys.exit(0)
try:
    monitores = json.loads(raw)
except ValueError:
    sys.exit(1)
if not isinstance(monitores, list):
    sys.exit(1)
for m in monitores:
    if not isinstance(m, dict):
        continue
    nome = m.get('name')
    if not nome:
        # Monitor sem nome nao da para enderecar; ignorar em silencio e melhor
        # que estourar um traceback que a mensagem de erro final atribuiria ao
        # hyprctl.
        continue
    # Um monitor desativado nao mostra nada; gravar override nele parecia dar
    # certo e nao mudava nada na tela.
    if m.get('disabled'):
        continue
    w = m.get('width')
    h = m.get('height')
    if not isinstance(w, int) or not isinstance(h, int):
        continue
    t = m.get('transform', 0)
    if not isinstance(t, int):
        t = 0
    # transform impar = rotacionado, entao inverte w/h para a geometria logica
    w, h = (h, w) if t % 2 else (w, h)
    if (h > w and alvo == 'portrait') or (w >= h and alvo == 'landscape'):
        print(nome)
" "$1")" || return 1
  if [ -z "$candidatos" ]; then
    return 1
  fi
  local n; n=$(printf '%s\n' "$candidatos" | grep -c .)
  if [ "$n" -gt 1 ]; then
    echo "aviso: mais de um monitor $1 detectado ($(printf '%s' "$candidatos" | tr '\n' ' ')); usando o primeiro" >&2
    echo "       para escolher outro, passe o nome: wp <h|v> <n> <MONITOR>" >&2
  fi
  printf '%s\n' "$candidatos" | head -n1
}

# Confere que o monitor pedido pelo nome existe, esta ativo e tem a orientacao
# esperada. Sem isso, `wp h 5 DP-9` gravaria override para um monitor
# inexistente sem reclamar.
valida_monitor() {  # $1 = nome, $2 = portrait|landscape
  local nome="$1" alvo="$2"
  command -v hyprctl >/dev/null 2>&1 || { echo "erro: hyprctl nao encontrado (sem Hyprland rodando?)" >&2; return 1; }
  hyprctl monitors -j | python3 -c "
import sys, json

nome, alvo = sys.argv[1], sys.argv[2]
raw = sys.stdin.read()
if not raw.strip():
    sys.exit(1)
try:
    monitores = json.loads(raw)
except ValueError:
    sys.exit(1)
if not isinstance(monitores, list):
    sys.exit(1)

for m in monitores:
    if not isinstance(m, dict) or m.get('name') != nome:
        continue
    if m.get('disabled'):
        print(f'erro: monitor {nome} esta desativado', file=sys.stderr)
        sys.exit(1)
    w = m.get('width')
    h = m.get('height')
    if not isinstance(w, int) or not isinstance(h, int):
        # Sem dimensoes nao da para conferir a orientacao; aceita, ja que o
        # usuario nomeou o monitor explicitamente.
        sys.exit(0)
    t = m.get('transform', 0)
    if not isinstance(t, int):
        t = 0
    w, h = (h, w) if t % 2 else (w, h)
    real = 'portrait' if h > w else 'landscape'
    if real != alvo:
        print(f'erro: monitor {nome} e {real}, nao {alvo}', file=sys.stderr)
        sys.exit(1)
    sys.exit(0)

print(f'erro: monitor {nome} nao encontrado em hyprctl monitors', file=sys.stderr)
sys.exit(1)
" "$nome" "$alvo"
}

lista() { # $1 = pasta, $2 = rotulo
  local d="$R/$1" i=1 f
  [ -d "$d" ] || { echo "  (sem $1)"; return 0; }
  echo "== $2 =="
  local a=()
  shopt -s nullglob
  a=("$d"/*.png)
  shopt -u nullglob
  for f in "${a[@]}"; do
    printf "  %2d. %s\n" "$i" "$(basename "${f%.png}")"
    i=$((i+1))
  done
  return 0
}

aplica() { # $1 = 16x9|9x16, $2 = indice, $3 = portrait|landscape, $4 = monitor (opcional)
  local d="$R/$1" n="$2" alvo="$3" mon_pedido="${4:-}"

  if [[ ! "$n" =~ ^[0-9]+$ ]]; then
    echo "erro: numero invalido: '$n' (use um inteiro simples, sem virgula/intervalo)" >&2
    return 1
  fi
  # Base 10 explicita: sem isso `wp h 09` estoura "value too great for base"
  # dentro do (( )), porque um zero a esquerda faz bash ler o numero como octal.
  n=$((10#$n))
  if (( n < 1 )); then
    echo "erro: numero $n fora de faixa (minimo 1)" >&2
    return 1
  fi

  local a=()
  shopt -s nullglob
  a=("$d"/*.png)
  shopt -u nullglob

  if (( ${#a[@]} == 0 )); then
    echo "erro: nenhuma arte encontrada em $d" >&2
    return 1
  fi
  if (( n > ${#a[@]} )); then
    echo "erro: numero $n fora de 1..${#a[@]}" >&2
    return 1
  fi
  local f="${a[n-1]}"

  local mon
  if [ -n "$mon_pedido" ]; then
    if [[ ! "$mon_pedido" =~ $MONITOR_RE ]]; then
      echo "erro: nome de monitor invalido: '$mon_pedido'" >&2
      return 1
    fi
    valida_monitor "$mon_pedido" "$alvo" || return 1
    mon="$mon_pedido"
  else
    mon=$(mon_por_orientacao "$alvo") || { echo "erro: nao foi possivel detectar monitor $alvo (verifique hyprctl)" >&2; return 1; }
    if [ -z "$mon" ]; then
      echo "erro: nenhum monitor $alvo detectado" >&2
      return 1
    fi
    if [[ ! "$mon" =~ $MONITOR_RE ]]; then
      echo "erro: hyprctl reportou um nome de monitor inesperado: '$mon'" >&2
      return 1
    fi
  fi

  # Propaga o codigo de saida do CLI: engoli-lo fazia `wp` sair 0 mesmo quando
  # nada era gravado.
  "$CLI" set "$mon" "$f"
}

uso() {
  cat <<'EOF'
uso: wp                    lista os dois catalogos
     wp h <n> [MONITOR]    aplica a n-esima arte deitada
     wp v <n> [MONITOR]    aplica a n-esima arte em pe
     wp h | wp v           so lista o catalogo correspondente

MONITOR e opcional: por padrao wp escolhe o primeiro monitor com a orientacao
pedida. Passe o nome (como aparece em `hyprctl monitors`) quando houver mais de
um monitor na mesma orientacao. Ex.: wp h 5 DP-3
EOF
}

rc=0
case "${1:-}" in
  h|horizontal|deitada)
    # if/then/else explicito: com `A && B || C`, uma falha do aplica caia no
    # `||` e imprimia o catalogo, sem erro nenhum na tela -- o usuario via a
    # lista e achava que tinha dado certo.
    if [ $# -ge 2 ]; then
      aplica 16x9 "$2" landscape "${3:-}" || rc=$?
    else
      lista 16x9 "DEITADAS (monitor horizontal)" || rc=$?
    fi
    ;;
  v|vertical|pe)
    if [ $# -ge 2 ]; then
      aplica 9x16 "$2" portrait "${3:-}" || rc=$?
    else
      lista 9x16 "EM PE (monitor vertical)" || rc=$?
    fi
    ;;
  ""|list|-l)
    lista 16x9 "DEITADAS (monitor horizontal)" || rc=$?
    echo
    lista 9x16 "EM PE (monitor vertical)" || rc=$?
    echo
    uso
    ;;
  -h|--help|help)
    uso
    ;;
  *)
    uso >&2
    rc=1
    ;;
esac

exit "$rc"
