#!/usr/bin/env bash
# wp - escolhe wallpaper por numero, por monitor.
#   wp                 lista os dois catalogos
#   wp h 12            aplica a 12a arte deitada no monitor horizontal
#   wp v 3             aplica a 3a arte em pe no monitor vertical
#   wp h               so lista as deitadas
# Descobre o monitor pela orientacao real (hyprctl), nao por nome chumbado.
set -uo pipefail
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
BASE="$(cd "$(dirname "$SELF")/.." && pwd)"
R="$BASE/render"
CLI="$(dirname "$SELF")/wallpaper-monitor"

mon_por_orientacao() {  # $1 = portrait|landscape
  command -v hyprctl >/dev/null 2>&1 || { echo "erro: hyprctl nao encontrado (sem Hyprland rodando?)" >&2; return 1; }
  local candidatos
  candidatos="$(hyprctl monitors -j | python3 -c "
import sys, json

alvo = sys.argv[1]
raw = sys.stdin.read()
if not raw.strip():
    sys.exit(0)
for m in json.loads(raw):
    # transform impar = rotacionado, entao inverte w/h para a geometria logica
    w, h = (m['height'], m['width']) if m['transform'] % 2 else (m['width'], m['height'])
    if (h > w and alvo == 'portrait') or (w >= h and alvo == 'landscape'):
        print(m['name'])
" "$1")"
  if [ -z "$candidatos" ]; then
    return 1
  fi
  local n; n=$(printf '%s\n' "$candidatos" | grep -c .)
  if [ "$n" -gt 1 ]; then
    echo "aviso: mais de um monitor $1 detectado ($(printf '%s' "$candidatos" | tr '\n' ' ')); usando o primeiro" >&2
  fi
  printf '%s\n' "$candidatos" | head -n1
}

lista() { # $1 = pasta, $2 = rotulo
  local d="$R/$1" i=1 f
  [ -d "$d" ] || { echo "  (sem $1)"; return; }
  echo "== $2 =="
  for f in "$d"/*.png; do
    [ -e "$f" ] || continue
    printf "  %2d. %s\n" "$i" "$(basename "${f%.png}")"
    i=$((i+1))
  done
}

aplica() { # $1 = 16x9|9x16, $2 = indice, $3 = portrait|landscape
  local d="$R/$1" n="$2"

  if [[ ! "$n" =~ ^[0-9]+$ ]]; then
    echo "erro: numero invalido: '$n' (use um inteiro simples, sem virgula/intervalo)" >&2
    exit 1
  fi
  if [ "$n" -lt 1 ] 2>/dev/null; then
    echo "erro: numero $n fora de faixa (minimo 1)" >&2
    exit 1
  fi

  local a=()
  shopt -s nullglob
  a=("$d"/*.png)
  shopt -u nullglob

  if (( n < 1 || n > ${#a[@]} )); then
    echo "erro: numero $n fora de 1..${#a[@]}" >&2
    exit 1
  fi
  local f="${a[n-1]}"

  local mon; mon=$(mon_por_orientacao "$3") || { echo "erro: nao foi possivel detectar monitor $3 (verifique hyprctl)" >&2; exit 1; }
  [ -z "$mon" ] && { echo "erro: nenhum monitor $3 detectado" >&2; exit 1; }
  "$CLI" set "$mon" "$f"
}

case "${1:-}" in
  h|horizontal|deitada) [ $# -ge 2 ] && aplica 16x9 "$2" landscape || lista 16x9 "DEITADAS (monitor horizontal)" ;;
  v|vertical|pe)        [ $# -ge 2 ] && aplica 9x16 "$2" portrait  || lista 9x16 "EM PE (monitor vertical)" ;;
  ""|list|-l)           lista 16x9 "DEITADAS (monitor horizontal)"; echo; lista 9x16 "EM PE (monitor vertical)";
                        echo; echo "uso: wp h <n>   |   wp v <n>" ;;
  *) echo "uso: wp [h|v] [numero]"; exit 1 ;;
esac
